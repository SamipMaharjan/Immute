# Ignore all node_modules folders recursively
**/node_modules/

# Optional: Ignore build artifacts
dist/
build/
out/

# Optional: Ignore environment files
.env
.env.local
.env.*.local

# next.js
/.next/
/out/

# Optional: Ignore log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Optional: Ignore editor-specific files
.vscode/
.idea/
.DS_Store

# Optional: Ignore lock files (if you don’t want to track them)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

